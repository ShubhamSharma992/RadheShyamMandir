# ---------- Database ----------
# Runs as its own service; nothing here is bundled with the frontend.
# DATABASE_URL="postgresql://temple:password@localhost:5432/temple?schema=public"

# ---------- Auth ----------
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"
SESSION_MAX_AGE_HOURS="12"

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="https://example.com"

# ---------- File storage ----------
# One of: cloudinary | s3 | supabase | local
STORAGE_PROVIDER="local"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="temple"

S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Supabase Dashboard -> Project Settings -> Database -> Connection string
# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="temple-media"

# ---------- Limits ----------
# MAX_IMAGE_MB="8"
# MAX_VIDEO_MB="200"
